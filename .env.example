# Synology DSM / File Station. Credentials are server-side only.
SYNOLOGY_BASE_URL=https://sznas.ali.cnvseq.com
SYNOLOGY_USERNAME=
SYNOLOGY_PASSWORD=
SYNOLOGY_ROOT_FOLDER=/

# BMP API contract. Keep every path blank until IT provides Swagger/Postman and the field contract is accepted.
BMP_BASE_URL=
BMP_SERVICE_TOKEN=
BMP_AUTH_PATH=
BMP_AUTH_CONTRACT_VERIFIED=false
# Only set after IT provides/accepts an adapter implementing yikon-bmp-auth-v1 exactly.
BMP_AUTH_CONTRACT_VERSION=
BMP_API_CONTRACT_VERSION=
BMP_HEALTH_PATH=
BMP_TENDER_PATH=
BMP_RESEARCH_PATH=
BMP_AFTERSALES_PATH=
BMP_EVENTS_PATH=
BMP_SALES_ANALYTICS_PATH=
BMP_PGD_REVIEW_PATH=
BMP_PGD_CENTERS_PATH=
BMP_TRAINING_PATH=

# Medical laboratory operational metrics. Keep rates with explicit numerators and denominators.
MEDICAL_LAB_BASE_URL=
MEDICAL_LAB_SERVICE_TOKEN=
MEDICAL_LAB_METRICS_PATH=
MEDICAL_LAB_HEALTH_PATH=

# AI may use these fact tables for management conclusions only after IT verifies their source contracts.
BMP_SALES_FACTS_VERIFIED=false
MEDICAL_LAB_METRICS_VERIFIED=false

# Comma-separated server-side allowlist for platform administrators.
PLATFORM_ADMIN_EMAILS=
# JSON map of employee email to allowed business regions. No entry means owner-only generic work items and no regional fact-table access.
# Example only: {"member@example.test":{"regions":["华南大区"]}}
PLATFORM_DATA_SCOPES={}

# Research workflow membership, populated by IT. No default business approval rights.
# Example only: {"pmo@example.test":{"roles":["pmo"],"regions":["华南"],"team":"学术"}}
RESEARCH_ROLE_BINDINGS={}
# Marketing authorization ceiling in cents. Blank: over-budget requests require exception review.
RESEARCH_AUTHORIZATION_CENTS=
