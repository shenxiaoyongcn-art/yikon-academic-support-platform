# Synology DSM / File Station. Credentials are server-side only.
SYNOLOGY_BASE_URL=https://sznas.ali.cnvseq.com
SYNOLOGY_USERNAME=
SYNOLOGY_PASSWORD=
SYNOLOGY_ROOT_FOLDER=/

# BMP API contract. Fill these after IT provides the gateway and service token.
BMP_BASE_URL=
BMP_SERVICE_TOKEN=
BMP_AUTH_PATH=/api/v1/auth/login
BMP_TENDER_PATH=/api/v1/tender-projects
BMP_RESEARCH_PATH=/api/v1/research-projects
BMP_AFTERSALES_PATH=/api/v1/aftersales-tickets
BMP_EVENTS_PATH=/api/v1/academic-events
BMP_SALES_ANALYTICS_PATH=/api/v1/sales-analytics
BMP_PGD_REVIEW_PATH=/api/v1/pgd-reviews
BMP_PGD_CENTERS_PATH=/api/v1/pgd-centers
BMP_TRAINING_PATH=/api/v1/genetic-counseling-training

# Medical laboratory operational metrics. Keep rates with explicit numerators and denominators.
MEDICAL_LAB_BASE_URL=
MEDICAL_LAB_SERVICE_TOKEN=
MEDICAL_LAB_METRICS_PATH=/api/v1/hospital-operation-metrics

# Comma-separated server-side allowlist for platform administrators.
PLATFORM_ADMIN_EMAILS=
